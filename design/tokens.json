{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Alembic, the Alkahest design system. Source of truth for `cargo xtask tokens` (generates the GPUI theme behind the src/ui facade). Format follows the W3C Design Tokens draft: every leaf has $value and $type. Colours are sRGB hex; alpha is written as an 8-digit hex.",

  "color": {
    "$type": "color",
    "dark": {
      "bg": {
        "base":    { "$value": "#0F1214", "$description": "window background" },
        "sidebar": { "$value": "#121518", "$description": "navigation rail, inset inputs" },
        "raised":  { "$value": "#161A1D", "$description": "cards, tables, panels" },
        "overlay": { "$value": "#1D2226", "$description": "menus, dialogs, secondary buttons, toasts" },
        "code":    { "$value": "#0B0D0F", "$description": "template editor, secrets" }
      },
      "line": {
        "subtle":  { "$value": "#22272C", "$description": "table row separators" },
        "default": { "$value": "#2A3036", "$description": "card borders, track of meters" },
        "strong":  { "$value": "#343B42", "$description": "input and button borders" },
        "dashed":  { "$value": "#4A5157", "$description": "read-only / external source outline" }
      },
      "text": {
        "primary":   { "$value": "#E8E6E1" },
        "secondary": { "$value": "#C9CDD1" },
        "muted":     { "$value": "#A7ADB3", "$description": "labels, captions" },
        "faint":     { "$value": "#7C848C", "$description": "axis ticks, token names; not for body text" },
        "onAccent":  { "$value": "#1A1206" }
      },
      "accent": {
        "default": { "$value": "#E3A63B", "$description": "brass: primary action, focus ring, selection, slider fill" },
        "text":    { "$value": "#F2C46E" },
        "subtle":  { "$value": "#2B2414", "$description": "active nav item, selected row" },
        "border":  { "$value": "#6B5320" },
        "focusRing": { "$value": "#E3A63B2E", "$description": "3px outer ring on focused inputs" }
      },
      "ok": {
        "default": { "$value": "#46B5A0", "$description": "verdigris: running, GPU resident, toggles on" },
        "text":    { "$value": "#6FD3BF" },
        "subtle":  { "$value": "#15302B" }
      },
      "info": {
        "default": { "$value": "#6EA8E6", "$description": "loading, downloading, verifying" },
        "text":    { "$value": "#9CC4F0" },
        "subtle":  { "$value": "#17263A" }
      },
      "danger": {
        "default": { "$value": "#E5664F", "$description": "cinnabar: stop, kill, revoke, delete" },
        "text":    { "$value": "#F08A75" },
        "subtle":  { "$value": "#2A1714" },
        "border":  { "$value": "#6A2E25" }
      },
      "muted": {
        "default": { "$value": "#7C848C", "$description": "idle, not loaded, disabled" },
        "subtle":  { "$value": "#22272C" }
      }
    },
    "light": {
      "bg": {
        "base":    { "$value": "#F4F5F3" },
        "sidebar": { "$value": "#ECEEEC" },
        "raised":  { "$value": "#FFFFFF" },
        "overlay": { "$value": "#ECEEEC" },
        "code":    { "$value": "#F0F1EF" }
      },
      "line": {
        "subtle":  { "$value": "#E3E6E8" },
        "default": { "$value": "#D3D7DA" },
        "strong":  { "$value": "#B9BFC4" },
        "dashed":  { "$value": "#9AA1A7" }
      },
      "text": {
        "primary":   { "$value": "#15191C" },
        "secondary": { "$value": "#2E3438" },
        "muted":     { "$value": "#4A5157" },
        "faint":     { "$value": "#5F676E" },
        "onAccent":  { "$value": "#1A1206" }
      },
      "accent": {
        "default": { "$value": "#E3A63B", "$description": "fills keep the brass; text and strokes use accent.text" },
        "text":    { "$value": "#8A5A08" },
        "subtle":  { "$value": "#FBF0DA" },
        "border":  { "$value": "#D9B26A" },
        "focusRing": { "$value": "#A86F0E33" }
      },
      "ok":     { "default": { "$value": "#2E8C7A" }, "text": { "$value": "#1E6B5D" }, "subtle": { "$value": "#E0F2EE" } },
      "info":   { "default": { "$value": "#3B7CC4" }, "text": { "$value": "#285E9A" }, "subtle": { "$value": "#E3EEF9" } },
      "danger": { "default": { "$value": "#C7442E" }, "text": { "$value": "#A3341F" }, "subtle": { "$value": "#FBE7E3" }, "border": { "$value": "#E9A99C" } },
      "muted":  { "default": { "$value": "#5F676E" }, "subtle": { "$value": "#E9ECEE" } }
    },
    "brand": {
      "brass":     { "$value": "#E3A63B" },
      "brassDeep": { "$value": "#A86F0E", "$description": "mark on light backgrounds" },
      "verdigris": { "$value": "#46B5A0" },
      "ink":       { "$value": "#0F1214" },
      "bone":      { "$value": "#E8E6E1" }
    }
  },

  "kind": {
    "$description": "Model kind palette. Badge = fg text + glyph + label on fg at 15% alpha (tint). Never colour alone.",
    "chat":       { "glyph": { "$type": "string", "$value": "◆" }, "label": { "$type": "string", "$value": "Chat" },       "fg": { "$type": "color", "$value": "#E3A63B" }, "tint": { "$type": "color", "$value": "#E3A63B26" } },
    "embeddings": { "glyph": { "$type": "string", "$value": "⋮" }, "label": { "$type": "string", "$value": "Embeddings" }, "fg": { "$type": "color", "$value": "#8E9BF0" }, "tint": { "$type": "color", "$value": "#8E9BF026" } },
    "rerank":     { "glyph": { "$type": "string", "$value": "⇅" }, "label": { "$type": "string", "$value": "Rerank" },     "fg": { "$type": "color", "$value": "#6FB3E8" }, "tint": { "$type": "color", "$value": "#6FB3E826" } },
    "vision":     { "glyph": { "$type": "string", "$value": "◉" }, "label": { "$type": "string", "$value": "Vision" },     "fg": { "$type": "color", "$value": "#46B5A0" }, "tint": { "$type": "color", "$value": "#46B5A026" } },
    "audio":      { "glyph": { "$type": "string", "$value": "∿" }, "label": { "$type": "string", "$value": "Audio" },      "fg": { "$type": "color", "$value": "#E08FC8" }, "tint": { "$type": "color", "$value": "#E08FC826" } },
    "image":      { "glyph": { "$type": "string", "$value": "▣" }, "label": { "$type": "string", "$value": "Image" },      "fg": { "$type": "color", "$value": "#EB8A5E" }, "tint": { "$type": "color", "$value": "#EB8A5E26" } },
    "video":      { "glyph": { "$type": "string", "$value": "▶" }, "label": { "$type": "string", "$value": "Video" },      "fg": { "$type": "color", "$value": "#B79CF2" }, "tint": { "$type": "color", "$value": "#B79CF226" } },
    "decision":   { "glyph": { "$type": "string", "$value": "⊢" }, "label": { "$type": "string", "$value": "Decision" },   "fg": { "$type": "color", "$value": "#A9C45A" }, "tint": { "$type": "color", "$value": "#A9C45A26" } }
  },

  "processorState": {
    "$description": "Pill shown in Library and Running. dot + label on bg.",
    "gpu":     { "bg": { "$type": "color", "$value": "#15302B" }, "fg": { "$type": "color", "$value": "#6FD3BF" }, "dot": { "$type": "color", "$value": "#46B5A0" }, "label": { "$type": "string", "$value": "GPU 100%" } },
    "split":   { "bg": { "$type": "color", "$value": "#2B2414" }, "fg": { "$type": "color", "$value": "#F2C46E" }, "dot": { "$type": "color", "$value": "#E3A63B" }, "label": { "$type": "string", "$value": "GPU {gpu}% · CPU {cpu}%" } },
    "cpu":     { "bg": { "$type": "color", "$value": "#22272C" }, "fg": { "$type": "color", "$value": "#C9CDD1" }, "dot": { "$type": "color", "$value": "#A7ADB3" }, "label": { "$type": "string", "$value": "CPU" } },
    "loading": { "bg": { "$type": "color", "$value": "#17263A" }, "fg": { "$type": "color", "$value": "#9CC4F0" }, "dot": { "$type": "color", "$value": "#6EA8E6" }, "label": { "$type": "string", "$value": "Loading… {pct}%" } },
    "off":     { "bg": { "$type": "color", "$value": "#00000000" }, "fg": { "$type": "color", "$value": "#A7ADB3" }, "dot": { "$type": "color", "$value": "#4A5157" }, "border": { "$type": "color", "$value": "#343B42" }, "label": { "$type": "string", "$value": "Not loaded" } }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":   { "$value": ["Schibsted Grotesk", "system-ui", "sans-serif"], "$description": "OFL-1.1, embed in the binary" },
      "mono": { "$value": ["IBM Plex Mono", "monospace"], "$description": "OFL-1.1; every number, id, path, quant, flag" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
    }
  },

  "type": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "32px", "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": "-0.02em" } },
    "h1":      { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "26px", "fontWeight": 600, "lineHeight": 1.2,  "letterSpacing": "-0.02em" }, "$description": "screen title" },
    "h2":      { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.3,  "letterSpacing": "0" }, "$description": "card title" },
    "title":   { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "0" } },
    "body":    { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" } },
    "small":   { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" } },
    "caption": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.4,  "letterSpacing": "0" } },
    "label":   { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.3,  "letterSpacing": "0.08em", "textTransform": "uppercase" }, "$description": "section and column headers" },
    "mono":    { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0" } },
    "monoLarge": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "24px", "fontWeight": 500, "lineHeight": 1.1, "letterSpacing": "0" }, "$description": "meter values" },
    "code":    { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12.5px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" } },
    "wordmark": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "-0.04em" }, "$description": "sidebar lockup; 104px with -0.045em on brand sheet" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "12": { "$value": "48px" }
  },

  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px",  "$description": "kbd hint, meter segments" },
    "sm":   { "$value": "6px",  "$description": "badges, tags" },
    "md":   { "$value": "8px",  "$description": "buttons, inputs, nav items" },
    "lg":   { "$value": "10px", "$description": "list items, inner panels" },
    "xl":   { "$value": "12px", "$description": "tables, model cards" },
    "2xl":  { "$value": "14px", "$description": "section cards" },
    "full": { "$value": "999px", "$description": "pills, filter chips" }
  },

  "shadow": {
    "$type": "shadow",
    "overlay": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px", "color": "#00000073" }, "$description": "only menus, dialogs, toasts; raised surfaces use a border, no shadow" }
  },

  "size": {
    "$type": "dimension",
    "sidebar":        { "$value": "232px" },
    "control":        { "$value": "38px", "$description": "buttons, inputs, selects" },
    "controlLarge":   { "$value": "42px", "$description": "primary search field" },
    "controlSmall":   { "$value": "32px", "$description": "row actions, filter chips" },
    "navItem":        { "$value": "40px" },
    "hitTarget":      { "$value": "44px", "$description": "minimum for toggles and rows" },
    "icon":           { "$value": "18px", "$description": "nav icons; 16px in controls; stroke 1.8" },
    "toggle":         { "$value": "38x22px" },
    "sliderTrack":    { "$value": "6px" },
    "sliderThumb":    { "$value": "16px" },
    "meter":          { "$value": "10px", "$description": "stacked VRAM bar; 6px for single meters, 4px for download progress" },
    "screenPadding":  { "$value": "24px 32px" },
    "cardPadding":    { "$value": "20px" },
    "minWindow":      { "$value": "960x640px" },
    "defaultWindow":  { "$value": "1440x900px" }
  }
}
