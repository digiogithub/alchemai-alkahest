# Alkahest system service (ALK-SP-0009.R2), generated by `alkahest service install`, which
# fills in the binary path and the groups.
[Unit]
Description=Alkahest local AI model server
Documentation=https://github.com/digio/alkahest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alkahest
Group=alkahest
@SUPPLEMENTARY_GROUPS@
# Models, keys and engines live below ALKAHEST_HOME; systemd creates it owned by the service
# user. The system configuration file /etc/alkahest/config.toml is read when it exists.
Environment=HOME=/var/lib/alkahest
Environment=ALKAHEST_HOME=/var/lib/alkahest
StateDirectory=alkahest
ExecStart=@EXEC_START@ serve
Restart=always
RestartSec=2
# Give in-flight requests time to drain (server.shutdown_timeout_secs, default 30).
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
# Output goes to journald: `journalctl -u alkahest`.

[Install]
WantedBy=multi-user.target
